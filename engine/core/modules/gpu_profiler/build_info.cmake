# Writes gpu_profiler_build_info.h with the git commit, branch and the "local changes" flag of the source tree.
# Runs on every build (target GpuProfilerBuildInfo) and rewrites the header only when its content changes, so the
# profiler recompiles one file after a commit or when the tree gets / loses local changes.
#
# cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -DPRESET=<name> -P build_info.cmake

set(commit "unknown")
set(branch "unknown")
set(dirty 0)

find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    set(commit "unknown")
  endif()
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD
    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  # Tracked files only: build output and local notes (untracked / excluded) do not count.
  execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT status STREQUAL "")
    set(dirty 1)
  endif()
endif()

set(content "// Generated by engine/core/modules/gpu_profiler/build_info.cmake at build time.
#pragma once
#define NAU_GPU_PROFILER_GIT_COMMIT \"${commit}\"
#define NAU_GPU_PROFILER_GIT_BRANCH \"${branch}\"
#define NAU_GPU_PROFILER_GIT_DIRTY ${dirty}
#define NAU_GPU_PROFILER_PRESET \"${PRESET}\"
")

set(previous "")
if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} previous)
endif()
if(NOT previous STREQUAL content)
  file(WRITE ${OUTPUT} "${content}")
endif()
